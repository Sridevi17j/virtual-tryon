# Virtual Try-On Backend Environment Variables

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Service URLs
KLING_OFFICIAL_SERVICE_URL=http://127.0.0.1:8004
KOLORS_SERVICE_URL=http://127.0.0.1:8003
ENHANCED_ML_SERVICE_URL=http://127.0.0.1:8001

# CORS Configuration (use * for development, specific domains for production)
CORS_ORIGINS=*

# File Storage
UPLOAD_DIR=uploads
RESULTS_DIR=results
MAX_FILE_SIZE_MB=10

# Optional: External Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# Optional: Redis for job queue
# REDIS_URL=redis://localhost:6379

# Optional: Database
# DATABASE_URL=postgresql://user:password@localhost/virtual_tryon
