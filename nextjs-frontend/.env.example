# Virtual Try-On Frontend Environment Variables

# API Configuration
# For local development, use localhost
# NEXT_PUBLIC_API_URL=/api/v1

# For production with Railway backend (proxied via Netlify)
NEXT_PUBLIC_API_URL=/api/v1

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=
